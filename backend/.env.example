# Django
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ENV=development

# Database (for PostgreSQL)
DB_NAME=db_name
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
# DB_SSLMODE=require  

# JWT
JWT_SECRET_KEY=change-me-another-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=MediCare Hub <noreply@medicarehub.com>

# CORS (production – comma separated)
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MediCare Hub <noreply@medicarehub.com>

# Redis (optional – leave empty to use in-memory cache / channels)
# REDIS_URL=redis://localhost:6379/0

# Security (production)
# SECURE_SSL_REDIRECT=True

# Sentry (optional)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# Axes (brute-force)
AXES_ENABLED=True