# =============================================================================
# MediCare Hub – Environment Variables
# Copy to .env (development) or .env.production (production)
# NEVER commit real secrets.
# =============================================================================

# --- Core Django ---
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
ENV=production

# --- Database (PostgreSQL) ---
# Prefer DATABASE_URL in production. Individual vars used as fallback.
DATABASE_URL=postgres://postgres:password@db:5432/healthcare_db
DB_NAME=healthcare_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=False

# --- Redis (required in production) ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-me-another-long-random-string-different-from-SECRET_KEY
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- CORS (comma-separated, no spaces around commas preferred) ---
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com

# --- Security (production) ---
SECURE_SSL_REDIRECT=True

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MediCare Hub <noreply@yourdomain.com>

# --- Sentry (optional) ---
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Logging ---
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# --- Axes (brute-force protection) ---
AXES_ENABLED=True

# --- Celery (defaults to REDIS_URL if not set) ---
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
