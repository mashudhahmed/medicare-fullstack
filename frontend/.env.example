# =============================================================================
# MediCare Hub – Frontend Environment (Vite)
# Only VITE_* variables are exposed to the browser.
# =============================================================================

# API base URL (no trailing slash). In production prefer relative /api/v1
# when frontend and backend share the same origin via reverse proxy.
VITE_API_URL=/api/v1

# WebSocket base (optional). Leave empty to derive from window.location.
VITE_WS_BASE_URL=

# App metadata
VITE_APP_NAME=MediCare Hub
VITE_APP_VERSION=1.0.0

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# Optional third-party (public keys only)
VITE_GOOGLE_MAPS_API_KEY=
VITE_STRIPE_PUBLIC_KEY=
