{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@components": ["src/components"],
      "@pages/*": ["src/pages/*"],
      "@pages": ["src/pages"],
      "@api/*": ["src/api/*"],
      "@api": ["src/api"],
      "@hooks/*": ["src/hooks/*"],
      "@hooks": ["src/hooks"],
      "@utils/*": ["src/utils/*"],
      "@utils": ["src/utils"],
      "@types/*": ["src/types/*"],
      "@types": ["src/types"],
      "@store/*": ["src/store/*"],
      "@store": ["src/store"],
      "@features/*": ["src/features/*"],
      "@features": ["src/features"],
      "@layouts/*": ["src/layouts/*"],
      "@layouts": ["src/layouts"],
      "@context/*": ["src/context/*"],
      "@context": ["src/context"],
      "@routes/*": ["src/routes/*"],
      "@routes": ["src/routes"],
      "@styles/*": ["src/styles/*"],
      "@styles": ["src/styles"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
